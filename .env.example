# Loopback by default. For LAN management set a specific LAN address, e.g. 192.168.1.10:9080.
NICEPROXY_PANEL_LISTEN=127.0.0.1:9080
NICEPROXY_HTTP_PORT=80
NICEPROXY_HTTPS_PORT=443
# Resource limits are per direct rule.
NICEPROXY_MAX_TCP_CONNECTIONS=16384
NICEPROXY_MAX_UDP_ASSOCIATIONS=1024
# Optional trusted Alpha UI releases root containing latest.json.
NICEPROXY_ALPHA_RELEASE_URL=
# Cloudflare OAuth callback. Loopback is inferred from the panel listener.
# For remote access use the exact registered HTTPS callback URL.
NICEPROXY_CF_REDIRECT_URL=
